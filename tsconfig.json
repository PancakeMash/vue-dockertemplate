{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "rootDir": "./backend/src",
    "outDir": "./backend/dist",
    "strict": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["./backend/src/**/*.ts"],
  "exclude": ["node_modules"]
}